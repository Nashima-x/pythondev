      "点数を入力してください：60\n",
      "点数を入力してください：70\n",
      "点数を入力してください：80\n",
      "点数を入力してください：90\n",
      "点数を入力してください：100\n",
      "点数を入力してください：-1\n",
      "5人のテストの平均点は80.0点です\n"
     ]
    }
   ],
   "source": [
    "i = 0\n",
    "j = 0\n",
    "while True:\n",
    "    point = int(input(\"点数を入力してください：\"))\n",
    "    print(f\"点数を入力してください：{point}\")\n",
    "\n",
    "    if point <= 0:\n",
    "        break\n",
    "\n",
    "    i += point\n",
    "    j += 1\n",
    "\n",
    "print(f\"{j}人のテストの平均点は{round(i / j,1)}点です\")\n",
    "\n",
    "\n",
    "\n"
   ]
  }
 ],
